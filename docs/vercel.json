{
  "rewrites": [
    { "source": "/docs", "destination": "/index.html" },
    { "source": "/docs/quickstart", "destination": "/quickstart.html" },
    { "source": "/docs/api", "destination": "/api.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
