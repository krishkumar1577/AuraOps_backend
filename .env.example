# API Configuration
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
# Production (Render): https://auraops-backend-s2gw.onrender.com
# CLI override: export AURAOPS_API_URL=https://auraops-backend-s2gw.onrender.com

# Authentication
JWT_SECRET=change-me-in-development-only

# MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=auraops

# Redis
REDIS_URL=redis://localhost:6379

# AWS S3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
S3_BUCKET=aura-weights

# Lambda Labs
LAMBDA_LABS_API_KEY=your-api-key

# Modal (GPU provider - free $30/month at modal.com)
MODAL_TOKEN_ID=your-token-id
MODAL_TOKEN_SECRET=your-token-secret
# Kill `modal deploy` after this many ms (default 600000 = 10 min; min 60000, max 1800000)
# MODAL_DEPLOY_TIMEOUT_MS=600000

# Agent secrets for local Modal deploy (optional)
# Prefer Modal secrets in production; plain keys are injected via os.environ.setdefault
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=
# JSON map of extra env vars for the agent container:
# AURAOPS_AGENT_ENV={"CUSTOM_KEY":"value"}
# Modal secret name(s) attached to the agent class:
# MODAL_SECRET_NAME=auraops-agent
# AURAOPS_MODAL_SECRET=auraops-agent

# Logging
LOG_LEVEL=info

# Warm Worker Pool
MIN_WARM_WORKERS=2
MAX_IDLE_MS=3600000

# API Guardrails (32MB default — allows project bundles on /api/v1/deploy; raise if needed, e.g. 50MB=52428800)
MAX_REQUEST_BODY_BYTES=33554432

# Loops.so (KRI-9 — CRO email onboarding)
LOOPS_API_KEY=

# Razorpay (pay-as-you-go credits for hosted --server deploys)
# Local `auraops deploy` is free (user's Modal). Hosted deploys spend credits.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set false only for emergency testing without billing
BILLING_ENFORCE=true

# Landing origins allowed for browser checkout (comma-separated).
# Defaults also include https://auraops.vercel.app
CORS_ORIGIN=https://auraops.vercel.app
